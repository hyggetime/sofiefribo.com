---
/** 우하단 — 페이지 상단(#home)으로 스크롤. 검정 섹션 위에서는 색상 반전 */
---

<button
  type="button"
  id="back-to-top"
  class="back-to-top fixed bottom-[max(1.25rem,env(safe-area-inset-bottom,0px))] right-4 z-[70] flex h-11 w-11 items-center justify-center border-2 border-black bg-black text-white opacity-0 shadow-lg transition-[opacity,background-color,color,border-color] duration-200 pointer-events-none data-[visible]:opacity-100 data-[visible]:pointer-events-auto data-[on-dark]:border-white data-[on-dark]:bg-white data-[on-dark]:text-black md:bottom-8 md:right-[25%] md:h-12 md:w-12"
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
>
  <svg
    class="h-5 w-5 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M12 5l-6 6M12 5l6 6"></path>
  </svg>
</button>

<script>
  const DARK_SECTIONS = "#projects, footer";
  const SCROLL_SHOW_DESKTOP = 280;
  const SCROLL_SHOW_MOBILE = 80;

  function initBackToTop() {
    const btn = document.getElementById("back-to-top");
    if (!btn) return;

    const mqMobile = window.matchMedia("(max-width: 767px)");

    function isMobile() {
      return mqMobile.matches;
    }

    function isOverDarkSection(): boolean {
      if (!btn.hasAttribute("data-visible")) return false;
      const rect = btn.getBoundingClientRect();
      const x = Math.min(Math.max(rect.left + rect.width / 2, 1), window.innerWidth - 1);
      const y = Math.min(Math.max(rect.top + rect.height / 2, 1), window.innerHeight - 1);
      const prev = btn.style.pointerEvents;
      btn.style.pointerEvents = "none";
      const hit = document.elementFromPoint(x, y);
      btn.style.pointerEvents = prev;
      if (!hit) return false;
      return !!hit.closest(DARK_SECTIONS);
    }

    function update() {
      const threshold = isMobile() ? SCROLL_SHOW_MOBILE : SCROLL_SHOW_DESKTOP;
      const scrolled = window.scrollY > threshold;
      btn.toggleAttribute("data-visible", scrolled);
      btn.setAttribute("aria-hidden", scrolled ? "false" : "true");
      btn.tabIndex = scrolled ? 0 : -1;
      btn.toggleAttribute("data-on-dark", isOverDarkSection());
    }

    btn.addEventListener("click", () => {
      const home = document.getElementById("home");
      if (home) {
        home.scrollIntoView({ behavior: "smooth", block: "start" });
      } else {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    mqMobile.addEventListener("change", update);
    update();
  }

  initBackToTop();
</script>
