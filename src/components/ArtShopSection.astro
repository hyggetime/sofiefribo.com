---
import {
  ART_SHOP_ASSETS,
  ART_SHOP_PRODUCTS,
  artShopThumbSrc,
} from "../data/artShopContent";

interface Props {
  sectionId?: string;
}

const { sectionId = "shop" } = Astro.props;
const { hero, thumb } = ART_SHOP_ASSETS;
---

<section id={sectionId} class="border-b-2 border-black bg-[#ffffff] py-16 md:py-24">
  <div class="mx-auto max-w-5xl px-4 md:px-8 lg:px-10">
    <figure class="mx-auto w-full max-w-md md:max-w-lg">
      <img
        src={hero.src}
        alt={hero.alt}
        width={hero.w}
        height={hero.h}
        loading="lazy"
        decoding="async"
        class="mx-auto h-auto w-full object-contain"
      />
    </figure>

    <div class="mx-auto mt-16 max-w-4xl md:mt-20 lg:mt-24">
      <ul
        class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-x-8 sm:gap-y-12 md:gap-x-12 md:gap-y-16 lg:gap-x-16 lg:gap-y-20"
        aria-label="Art shop products"
      >
        {
          ART_SHOP_PRODUCTS.map((product) => (
            <li class="min-w-0">
              <a
                href={product.href}
                class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
                aria-label={product.title}
              >
                <div class="relative aspect-square w-full overflow-hidden border-2 border-black bg-[#ffffff] transition group-hover:opacity-90">
                  <img
                    src={artShopThumbSrc(product.placeholder)}
                    alt=""
                    width={thumb.w}
                    height={thumb.h}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </div>
                <p class="mt-4 text-center text-xs font-bold uppercase tracking-wide text-neutral-800 md:mt-5 md:text-sm">
                  {product.title}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
