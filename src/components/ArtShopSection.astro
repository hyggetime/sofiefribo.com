---
import { ART_SHOP_ASSETS } from "../data/artShopContent";

interface Props {
  sectionId?: string;
}

const { sectionId = "shop" } = Astro.props;
const { hero } = ART_SHOP_ASSETS;
---

<section id={sectionId} class="border-b-2 border-black bg-[#ffffff] py-16 md:py-24">
  <div class="mx-auto max-w-5xl px-4 md:px-8 lg:px-10">
    <figure class="mx-auto w-full max-w-md md:max-w-lg">
      <img
        src={hero.src}
        alt={hero.alt}
        width={hero.w}
        height={hero.h}
        loading="lazy"
        decoding="async"
        class="mx-auto h-auto w-full object-contain"
      />
    </figure>

    <div class="mx-auto mt-16 max-w-4xl md:mt-20 lg:mt-24">
      <p
        class="text-center text-[1.6875rem] font-bold leading-snug tracking-wide text-neutral-800 md:text-[1.875rem]"
        aria-live="polite"
      >
        Coming Soon..
      </p>
    </div>
  </div>
</section>
