---
import Layout from "../layouts/Layout.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ImageSizeBadge from "../components/ImageSizeBadge.astro";
import { hiddenClass } from "../config/siteVisibility";
import { translations, defaultLocale } from "../i18n/translations";
import { SOFIEFRIBO_SUBPAGES } from "../data/sofiefriboSubpages";
import { resolveMailClubSubscribeUrl } from "../data/mailClubContent";
import MailClubSection from "../components/MailClubSection.astro";
import ArtShopSection from "../components/ArtShopSection.astro";
import SiteFooter from "../components/SiteFooter.astro";

const t = translations[defaultLocale];
const shopifyUrl =
  import.meta.env.PUBLIC_SHOPIFY_URL?.toString().trim() || "https://www.shopify.com";
const mailClubSubscribeUrl = resolveMailClubSubscribeUrl(import.meta.env.PUBLIC_SHOPIFY_MAILCLUB_URL);
const instagramUrl = "https://www.instagram.com/sofiefribo_illustration/";
const email = "sofiefribo.korea@gmail.com";
const logoSrc = "/images/misc/소피_피보.png";
/** 표시 크기 — 기존 36px(h-9)의 60% */
const logoSize = 22;

/** 권장 에셋 크기(px) — placehold·배지·width/height와 동기 */
const imgDims = {
  hero: { w: 1400, h: 1400 },
  avatar: { w: 128, h: 128 },
} as const;

const ph = (label: string, w: number, h: number) =>
  `https://placehold.co/${w}x${h}/ffffff/171717/png?text=${encodeURIComponent(label)}`;

/** 히어로 하단 — Mailclub · Shop · PortFoilo (열 3등분, Mailclub 높이 기준) */
const heroThumbs = SOFIEFRIBO_SUBPAGES;

const heroThumbHref = (key: (typeof SOFIEFRIBO_SUBPAGES)[number]["key"]) =>
  key === "mailclub" ? "#mailclub" : key === "shop" ? "#shop" : "#projects";

const img = {
  heroIllustration: "/images/hero/SOFIE_FRIBO_HERO.png",
} as const;

const testimonials = [
  {
    quote:
      "“Placeholder — warm testimonial about workshops, patience with beginners, and the calm clarity of Sofie’s drawing demos.”",
    name: "A. Reader",
    role: "Library programme lead",
  },
  {
    quote:
      "“Placeholder — middle card inverted in the template. Swap for a Hygge Time or collaborator quote when ready.”",
    name: "Hygge Time",
    role: "Product & storytelling",
  },
  {
    quote:
      "“Placeholder — short praise for packaging art direction, colour restraint, and friendly line work on shelf.”",
    name: "Retail partner",
    role: "Shop display",
  },
] as const;
---

<Layout title={t.meta.title} description={t.meta.description}>
  <LanguageSwitcher />

  <header
    class="sticky top-0 z-50 border-b-2 border-black bg-[#ffffff]"
    aria-label="Primary"
  >
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-4 md:px-6 lg:px-8"
    >
      <a href="#home" class="flex items-center gap-2 text-black">
        <img
          src={logoSrc}
          alt=""
          width={logoSize}
          height={logoSize}
          class="h-[22px] w-[22px] shrink-0 object-contain"
          decoding="async"
        />
        <span class="text-sm font-bold tracking-tight md:text-base" data-i18n="hero.name">{t.hero.name}</span>
      </a>
      <nav
        class="order-3 flex w-full flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold md:order-none md:flex-1 md:justify-center md:gap-8"
        aria-label="Sections"
      >
        <a href="#mailclub" class="hover:underline">Mail Club</a>
        <a href="#shop" class="hover:underline">Art shop</a>
        <a href="#projects" class="hover:underline">Projects</a>
        <a href="#contact" class:list={["hover:underline", hiddenClass("nav.contact")]}>Contact Me</a>
      </nav>
      <a
        href="#contact"
        class:list={[
          "inline-flex items-center gap-2 border-2 border-black bg-black px-4 py-2 text-xs font-bold uppercase tracking-wide text-white hover:bg-neutral-900",
          hiddenClass("nav.resume"),
        ]}
      >
        <span class="font-mono text-[10px]">[ICON]</span>
        Resume
      </a>
    </div>
  </header>

  <section id="home" class="border-b-2 border-black bg-[#ffffff]">
    <div
      class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-2 md:items-center md:gap-16 md:px-6 md:py-24 lg:px-8"
    >
      <div class="order-2 min-w-0 md:order-1">
        <p
          class="text-pretty text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl lg:text-6xl"
          data-i18n="landing.hello"
        >
          {t.landing.hello}
        </p>
        <p
          class="mt-8 max-w-xl text-base leading-relaxed text-neutral-700 md:text-lg"
          data-i18n="landing.heroBlurb"
        >
          {t.landing.heroBlurb}
        </p>
      </div>
      <figure class="order-1 min-w-0 md:order-2">
        <div class="relative aspect-square w-full max-w-lg overflow-hidden bg-[#ffffff] md:ml-auto">
          <img
            src={img.heroIllustration}
            alt="Sofie Fribo — illustration"
            width={imgDims.hero.w}
            height={imgDims.hero.h}
            loading="eager"
            decoding="async"
            class="h-full w-full object-contain object-center"
          />
        </div>
      </figure>
    </div>

    <div class="bg-[#ffffff] py-6 md:py-8" aria-label="Quick links">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-12 lg:px-16 xl:px-20">
        <div
          class="mx-auto grid w-full max-w-full grid-cols-3 gap-2 sm:gap-3 md:w-[48.75%] md:max-w-[48.75%] md:gap-2 lg:gap-2.5"
        >
          {
            heroThumbs.map((thumb) => (
              <a
                href={heroThumbHref(thumb.key)}
                aria-label={thumb.title}
                class="press-surface group flex min-w-0 flex-col justify-end bg-[#ffffff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
              >
                {/* Mailclub 600×400 비율 = 셀 높이 기준; Shop·PortFoilo는 같은 높이에 맞춤 */}
                <div class="relative aspect-[3/2] w-full min-w-0 overflow-hidden">
                  {
                    thumb.key === "mailclub" ? (
                      <img
                        src={thumb.image}
                        alt=""
                        width={thumb.imageW}
                        height={thumb.imageH}
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-x-0 bottom-0 h-full w-full max-w-full object-contain object-bottom"
                      />
                    ) : (
                      <img
                        src={thumb.image}
                        alt=""
                        width={thumb.imageH}
                        height={thumb.imageH}
                        loading="lazy"
                        decoding="async"
                        class:list={[
                          "absolute bottom-0 left-1/2 h-full w-auto max-w-full -translate-x-1/2 object-contain object-bottom",
                          thumb.key === "shop" && "origin-bottom md:scale-[1.03] md:translate-y-[6px]",
                          thumb.key === "portfoilo" && "origin-bottom md:scale-[1.2] md:translate-y-[10px]",
                        ]}
                      />
                    )
                  }
                </div>
                <span class="sr-only">{thumb.title}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <MailClubSection sectionId="mailclub" subscribeUrl={mailClubSubscribeUrl} />

  <ArtShopSection sectionId="shop" />

  <section id="projects" class="border-b-2 border-black bg-black py-20 text-white md:py-28">
    <div class="mx-auto max-w-6xl px-4 md:px-6 lg:px-8">
      <h2 class="text-center text-3xl font-bold md:text-4xl">
        My <span class="font-black">Projects</span>
      </h2>
      <p
        class="mx-auto mt-16 max-w-4xl text-center text-[1.6875rem] font-bold leading-snug tracking-wide text-white md:mt-20 md:text-[1.875rem]"
        aria-live="polite"
      >
        Coming Soon..
      </p>
    </div>
  </section>

  <section id="archive" class:list={["border-b-2 border-black bg-[#ffffff] py-20 md:py-28", hiddenClass("section.archive")]}>
    <div class="mx-auto max-w-3xl px-4 md:px-6 lg:px-8">
      <h2 class="text-3xl font-bold md:text-4xl" data-i18n="archive.title">{t.archive.title}</h2>
      <p class="mt-3 text-sm text-neutral-600 md:text-base" data-i18n="archive.subtitle">{t.archive.subtitle}</p>

      <h3 class="mt-14 text-xl font-bold" data-i18n="career.title">{t.career.title}</h3>
      <p class="mt-2 text-sm text-neutral-600" data-i18n="career.hint">{t.career.hint}</p>
      <div id="career-accordion" class="mt-8 border-t-2 border-black">
        {
          t.career.blocks.map((block) => (
            <details class="group border-b-2 border-neutral-300">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 outline-none [&::-webkit-details-marker]:hidden">
                <span class="text-base font-bold text-black md:text-lg">{block.year}</span>
                <span class="font-mono text-[10px] text-neutral-500" aria-hidden="true">
                  [+]
                </span>
              </summary>
              <div class="border-t border-neutral-200 bg-[#ffffff] px-1 py-4 md:px-3">
                <ul class="list-disc space-y-2 pl-5 text-sm leading-relaxed text-neutral-700 md:text-[15px]">
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>

      <div class="mt-16 border-2 border-black bg-[#ffffff] p-6 md:p-8">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-neutral-500">Hygge Time</p>
        <h3 class="mt-2 text-2xl font-bold" data-i18n="collaboration.title">{t.collaboration.title}</h3>
        <p class="mt-2 text-lg font-bold" data-i18n="collaboration.role">{t.collaboration.role}</p>
        <div class="mt-6 space-y-4 text-neutral-800">
          <p data-i18n="collaboration.p1">{t.collaboration.p1}</p>
          <p data-i18n="collaboration.p2">{t.collaboration.p2}</p>
        </div>
        <a
          href={shopifyUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-i18n-attr="collaboration.shopify"
          data-i18n="collaboration.shopifyCta"
          aria-label={`${t.collaboration.shopifyCta}. ${t.collaboration.shopifyHint}`}
          class="mt-8 inline-flex items-center gap-2 border-2 border-black bg-black px-6 py-3 text-sm font-bold text-white hover:bg-neutral-900"
        >
          {t.collaboration.shopifyCta}
        </a>
      </div>
    </div>
  </section>

  <section id="testimonials" class:list={["border-b-2 border-black bg-[#ffffff] py-20 md:py-28", hiddenClass("section.testimonials")]}>
    <div class="mx-auto max-w-6xl px-4 md:px-6 lg:px-8">
      <h2 class="text-center text-3xl font-bold md:text-4xl">
        My <span class="font-black">Testimonial</span>
      </h2>
      <div class="mt-14 grid gap-6 md:grid-cols-3 md:gap-8">
        {
          testimonials.map((item, i) => (
            <article
              class:list={[
                "flex flex-col border-2 border-black p-6 md:p-7",
                i === 1 ? "bg-black text-white" : "bg-[#ffffff] text-black",
              ]}
            >
              <div
                class:list={[
                  "relative mx-auto flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 text-[10px] font-mono",
                  i === 1 ? "border-white bg-neutral-900 text-neutral-300" : "border-black bg-[#ffffff] text-neutral-500",
                ]}
              >
                <ImageSizeBadge
                  w={imgDims.avatar.w}
                  h={imgDims.avatar.h}
                  compact
                  tone={i === 1 ? "dark" : "light"}
                />
                <img
                  src={ph(`Avatar ${i + 1}`, imgDims.avatar.w, imgDims.avatar.h)}
                  alt=""
                  width={64}
                  height={64}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
              <p
                class:list={[
                  "mt-6 flex-1 text-sm leading-relaxed md:text-[15px]",
                  i === 1 ? "text-neutral-200" : "text-neutral-700",
                ]}
              >
                {item.quote}
              </p>
              <p class:list={["mt-6 text-sm font-bold", i === 1 ? "text-white" : "text-black"]}>{item.name}</p>
              <p class:list={["text-xs font-semibold", i === 1 ? "text-neutral-400" : "text-neutral-500"]}>
                {item.role}
              </p>
            </article>
          ))
        }
      </div>
      <div
        class="mx-auto mt-12 flex max-w-3xl flex-col gap-4 rounded-md border-2 border-black bg-[#ffffff] px-6 py-5 text-sm md:flex-row md:items-center md:justify-between md:text-base"
      >
        <p class="font-semibold text-black" data-i18n="footer.contactLabel">{t.footer.contactLabel}</p>
        <div class="flex flex-col gap-2 md:flex-row md:gap-8">
          <a
            href={`mailto:${email}`}
            class="font-medium underline decoration-neutral-400 underline-offset-4 hover:decoration-black"
            data-i18n-attr="footer.mail"
            aria-label={t.footer.mailAria}
          >
            {email}
          </a>
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium underline decoration-neutral-400 underline-offset-4 hover:decoration-black"
            data-i18n-attr="footer.instagram"
            aria-label={t.footer.instagramAria}
          >
            @sofiefribo_illustration
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class:list={["border-b-2 border-black bg-[#ffffff] py-20 md:py-28", hiddenClass("section.contact")]}>
    <div class="mx-auto grid max-w-6xl gap-14 px-4 md:grid-cols-2 md:gap-16 md:px-6 lg:px-8">
      <div>
        <form id="contact-form" class="space-y-4" action="#" method="post">
          <label class="block text-xs font-bold uppercase tracking-wide text-neutral-600">
            Your Name
            <input
              type="text"
              name="name"
              autocomplete="name"
              class="mt-2 w-full border-2 border-black bg-[#ffffff] px-3 py-3 text-sm outline-none focus:ring-2 focus:ring-black/20"
              placeholder="Name"
            />
          </label>
          <label class="block text-xs font-bold uppercase tracking-wide text-neutral-600">
            Email
            <input
              type="email"
              name="email"
              autocomplete="email"
              class="mt-2 w-full border-2 border-black bg-[#ffffff] px-3 py-3 text-sm outline-none focus:ring-2 focus:ring-black/20"
              placeholder="you@example.com"
            />
          </label>
          <label class="block text-xs font-bold uppercase tracking-wide text-neutral-600">
            Your website (if any)
            <input
              type="url"
              name="website"
              class="mt-2 w-full border-2 border-black bg-[#ffffff] px-3 py-3 text-sm outline-none focus:ring-2 focus:ring-black/20"
              placeholder="https://"
            />
          </label>
          <label class="block text-xs font-bold uppercase tracking-wide text-neutral-600">
            How can I help?
            <textarea
              name="message"
              rows={5}
              class="mt-2 w-full resize-y border-2 border-black bg-[#ffffff] px-3 py-3 text-sm outline-none focus:ring-2 focus:ring-black/20"
              placeholder="Message"
            />
          </label>
          <button
            type="submit"
            class="w-full border-2 border-black bg-black py-3 text-sm font-bold uppercase tracking-wide text-white hover:bg-neutral-900 md:w-auto md:px-10"
          >
            Get in Touch
          </button>
          <div class="flex gap-3 pt-2">
            <span class="flex h-11 w-11 items-center justify-center border-2 border-black text-[10px] font-bold">[f]</span>
            <span class="flex h-11 w-11 items-center justify-center border-2 border-black text-[10px] font-bold">[ig]</span>
            <span class="flex h-11 w-11 items-center justify-center border-2 border-black text-[10px] font-bold">[x]</span>
            <span class="flex h-11 w-11 items-center justify-center border-2 border-black text-[10px] font-bold">[in]</span>
          </div>
        </form>
      </div>
      <div>
        <h2 class="text-3xl font-bold leading-tight md:text-4xl">
          Let’s <span class="font-black">talk</span> for<br />Something special
        </h2>
        <p class="mt-6 text-neutral-700">
          Placeholder — short invite to collaborate on illustration, workshops, or Hygge Time launches. Prefer
          email or Instagram DMs for fastest replies.
        </p>
        <p class="mt-8 text-lg font-bold">
          <a href={`mailto:${email}`} class="hover:underline">{email}</a>
        </p>
        <p class="mt-2 text-lg font-bold text-neutral-700">+82 10-0000-0000</p>
        <p class="mt-6">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold underline decoration-neutral-400 underline-offset-4 hover:decoration-black"
          >
            Instagram — @sofiefribo_illustration
          </a>
        </p>
      </div>
    </div>
  </section>

  <SiteFooter t={t} logoSrc={logoSrc} logoSize={logoSize} instagramUrl={instagramUrl} />

  <script is:inline>
    (function () {
      function initForm() {
        var f = document.getElementById("contact-form");
        if (!f) return;
        f.addEventListener("submit", function (e) {
          e.preventDefault();
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initForm);
      } else {
        initForm();
      }
    })();
  </script>
</Layout>
