---
interface Props {
  title?: string;
  description?: string;
}

import BackToTop from "../components/BackToTop.astro";

const {
  title = "Sofie Fribo — Portfolio",
  description = "Illustration, workshops, and Hygge Time — portfolio.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen bg-[#ffffff] font-sans text-neutral-900 antialiased selection:bg-black/10 selection:text-black"
  >
    <slot />
    <BackToTop />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    background-color: #ffffff;
  }

  .press-surface {
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }
  .press-surface::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background-color: transparent;
    transition: background-color 75ms ease;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .press-surface:hover::after {
      background-color: rgba(120, 110, 95, 0.14);
    }
  }
  .press-surface:active::after {
    background-color: rgba(120, 110, 95, 0.14);
  }
</style>
