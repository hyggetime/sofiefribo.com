---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sofie Fribo — Portfolio",
  description = "Illustration, workshops, and Hygge Time — portfolio.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen bg-white font-sans text-neutral-900 antialiased selection:bg-black/10 selection:text-black"
  >
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    background-color: #ffffff;
  }
</style>
